# Atala Konten — contoh variabel lingkungan.
# Salin menjadi .env.local untuk pengembangan. Jangan pernah commit nilai asli.
# Di Vercel, isi lewat Project Settings > Environment Variables (Production dan Preview).

# ---------------------------------------------------------------------------
# Login admin (wajib di Vercel/production)
# ---------------------------------------------------------------------------
# Nama pengguna admin tunggal.
ADMIN_USERNAME=
# Hash scrypt kata sandi admin. Buat dengan: npm run hash-password
# Format: scrypt$<N>$<r>$<p>$<salt>$<hash>
# Di file .env, tulis setiap tanda $ sebagai \$ (skrip mencetak versi yang sudah di-escape).
# Di dashboard Vercel, tempel nilai apa adanya tanpa escape.
ADMIN_PASSWORD_HASH=
# Rahasia penandatangan cookie sesi, acak dan minimal 32 karakter.
# Contoh pembuatan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Mengganti nilai ini akan mengeluarkan semua sesi aktif.
SESSION_SECRET=

# Login demo admin / admin123 hanya aktif bila ADMIN_* kosong, bukan di Vercel,
# dan NODE_ENV bukan production. Set "true" hanya untuk mencoba `next start` secara lokal.
# Jangan pernah diisi di Vercel.
ALLOW_DEMO_LOGIN=

# ---------------------------------------------------------------------------
# Data terstruktur (Google Sheets)
# ---------------------------------------------------------------------------
# Kosongkan untuk otomatis: Google Sheets bila GOOGLE_* terisi, selain itu data lokal .data/ (pengembangan saja).
# "sheets" = wajib Google Sheets (tidak pernah jatuh ke data lokal; bila GOOGLE_* kosong aplikasi menampilkan galat konfigurasi).
# "fixture" = izinkan data lokal .data/ saat `next start` di komputer sendiri. Tidak berlaku di Vercel.
DATA_ADAPTER=
# Opsional: folder data lokal (bawaan: .data di root proyek). Hanya untuk pengembangan/uji.
ATALA_DATA_DIR=
# JSON service account Google dalam satu baris, atau versi base64 dari file JSON tersebut.
# Bagikan spreadsheet ke email service account dengan akses Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID spreadsheet (bagian URL di antara /d/ dan /edit).
GOOGLE_SHEET_ID=

# ---------------------------------------------------------------------------
# Foto (Vercel Blob privat)
# ---------------------------------------------------------------------------
# Token baca/tulis dari Blob store privat yang terhubung ke project Vercel.
BLOB_READ_WRITE_TOKEN=
